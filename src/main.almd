import self as bgm
import json
import value
effect fn main() -> Unit = {
  // 3 曲、cur=2 (末尾) の例
  println(json.stringify(value.object([
    ("next_wrap", value.int(bgm.next(2, 3, true))),     // 末尾→先頭=0
    ("next_nowrap", value.int(bgm.next(2, 3, false))),   // 末尾維持=2
    ("prev_wrap", value.int(bgm.prev(0, 3, true))),      // 先頭→末尾=2
    ("shuffle_from0", value.int(bgm.shuffle_next(0, 3, 0.5))),  // 0以外
    ("clamp_oob", value.int(bgm.clamp(9, 3))),           // 2
    ("empty", value.int(bgm.next(0, 0, true))),          // -1
  ])))
}
