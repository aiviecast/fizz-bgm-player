// wasm — ブラウザの BGM コントロールから呼ぶ。index のみ(Float 授受、文字列なし)。
import self as bgm
import float
import int
@export(wasm, "next")
fn bgm_next(cur: Float, count: Float, wrap: Float) -> Float =
  float.from(bgm.next(int.from_saturating(cur), int.from_saturating(count), wrap > 0.5))
@export(wasm, "prev")
fn bgm_prev(cur: Float, count: Float, wrap: Float) -> Float =
  float.from(bgm.prev(int.from_saturating(cur), int.from_saturating(count), wrap > 0.5))
@export(wasm, "shuffle_next")
fn bgm_shuffle(cur: Float, count: Float, rand01: Float) -> Float =
  float.from(bgm.shuffle_next(int.from_saturating(cur), int.from_saturating(count), rand01))
@export(wasm, "clamp")
fn bgm_clamp(idx: Float, count: Float) -> Float =
  float.from(bgm.clamp(int.from_saturating(idx), int.from_saturating(count)))
effect fn main() -> Unit = {
  let _a = bgm_next(0.0, 3.0, 1.0)
  let _b = bgm_prev(0.0, 3.0, 1.0)
  let _c = bgm_shuffle(0.0, 3.0, 0.5)
  let _d = bgm_clamp(0.0, 3.0)
  ()
}
