import self as bgm
test "next wraps / clamps" {
  assert_eq(bgm.next(0, 3, true), 1)
  assert_eq(bgm.next(2, 3, true), 0)      // wrap
  assert_eq(bgm.next(2, 3, false), 2)     // no wrap, hold
  assert_eq(bgm.next(0, 0, true), 0 - 1)  // empty
}
test "prev wraps / clamps" {
  assert_eq(bgm.prev(1, 3, true), 0)
  assert_eq(bgm.prev(0, 3, true), 2)      // wrap
  assert_eq(bgm.prev(0, 3, false), 0)     // no wrap, hold
}
test "clamp" {
  assert_eq(bgm.clamp(9, 3), 2)
  assert_eq(bgm.clamp(0 - 1, 3), 0)
  assert_eq(bgm.clamp(0, 0), 0 - 1)
}
test "shuffle_next picks a different track" {
  assert(bgm.shuffle_next(0, 3, 0.0) != 0)    // 0 以外
  assert(bgm.shuffle_next(0, 3, 0.99) != 0)
  assert(bgm.shuffle_next(1, 3, 0.0) != 1)
  assert_eq(bgm.shuffle_next(0, 1, 0.5), 0)   // 1 曲なら自分
  assert_eq(bgm.shuffle_next(0, 0, 0.5), 0 - 1)
}
